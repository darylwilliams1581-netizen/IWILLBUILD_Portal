# VCS + local tooling metadata
.git
.gitignore
.gitattributes

# Node deps and build artifacts
node_modules
dist

# Logs/temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/_logs
*.log
.DS_Store
