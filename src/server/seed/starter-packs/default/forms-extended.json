[
  {
    "name": "Daily Prestart — Vehicle & Plant",
    "formType": "Fleet",
    "category": "Fleet",
    "description": "Daily pre-start inspection checklist for vehicles and plant equipment.",
    "onJobs": false,
    "onFleet": true,
    "onDashboard": false,
    "fields": [
      { "label": "Date", "fieldType": "date", "required": true },
      { "label": "Vehicle / Plant ID", "fieldType": "text", "required": true },
      { "label": "Odometer / Hours Reading", "fieldType": "text", "required": true },
      { "label": "Driver / Operator Name", "fieldType": "text", "required": true },
      { "label": "Tyres — condition and pressure OK?", "fieldType": "checkbox", "required": true },
      { "label": "Lights and indicators working?", "fieldType": "checkbox", "required": true },
      { "label": "Brakes operating correctly?", "fieldType": "checkbox", "required": true },
      { "label": "Engine oil level OK?", "fieldType": "checkbox", "required": true },
      { "label": "Coolant level OK?", "fieldType": "checkbox", "required": true },
      { "label": "Fuel level adequate?", "fieldType": "checkbox", "required": true },
      { "label": "Windscreen — no cracks or chips affecting vision?", "fieldType": "checkbox", "required": true },
      { "label": "Mirrors — clean and correctly adjusted?", "fieldType": "checkbox", "required": true },
      { "label": "Seatbelts functioning?", "fieldType": "checkbox", "required": true },
      { "label": "First aid kit present and stocked?", "fieldType": "checkbox", "required": true },
      { "label": "Fire extinguisher present and in date?", "fieldType": "checkbox", "required": true },
      { "label": "Any defects or damage to report?", "fieldType": "textarea", "required": false },
      { "label": "Vehicle fit for use today?", "fieldType": "select", "required": true, "options": ["Yes — fit for use", "No — defect reported, taken out of service"] },
      { "label": "Driver Signature", "fieldType": "signature", "required": true }
    ]
  },
  {
    "name": "Toolbox Talk Record",
    "formType": "Job",
