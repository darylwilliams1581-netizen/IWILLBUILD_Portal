    ]
  },
  {
    "name": "Incident / Injury / Near Miss Report",
    "formType": "Job",
    "category": "Safety",
    "description": "Report form for workplace incidents, injuries, and near miss events.",
    "onJobs": true,
    "onFleet": false,
    "onDashboard": false,
    "fields": [
      { "label": "Date of Incident", "fieldType": "date", "required": true },
      { "label": "Time of Incident", "fieldType": "text", "required": true },
      { "label": "Location / Site", "fieldType": "text", "required": true },
      { "label": "Type of Event", "fieldType": "select", "required": true, "options": ["Injury", "Near Miss", "Property Damage", "Environmental", "Other"] },
      { "label": "Person(s) Involved", "fieldType": "text", "required": true },
      { "label": "Description of Incident", "fieldType": "textarea", "required": true },
      { "label": "Immediate Cause(s)", "fieldType": "textarea", "required": true },
      { "label": "Underlying / Root Cause(s)", "fieldType": "textarea", "required": false },
      { "label": "Injuries Sustained (if any)", "fieldType": "textarea", "required": false },
      { "label": "First Aid Treatment Given", "fieldType": "textarea", "required": false },
      { "label": "Medical Treatment Required?", "fieldType": "select", "required": true, "options": ["No", "First Aid Only", "Doctor / Hospital Visit", "Hospitalisation", "Lost Time Injury"] },
      { "label": "Corrective Actions Taken", "fieldType": "textarea", "required": true },
      { "label": "Preventive Actions to Avoid Recurrence", "fieldType": "textarea", "required": true },
      { "label": "Reported By", "fieldType": "text", "required": true },
      { "label": "Supervisor Notified?", "fieldType": "checkbox", "required": true },
      { "label": "Regulator Notification Required?", "fieldType": "select", "required": true, "options": ["No", "Yes — notified", "Under review"] },
      { "label": "Signature", "fieldType": "signature", "required": true }
    ]
  },
