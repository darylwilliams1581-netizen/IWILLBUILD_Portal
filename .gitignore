# Turnscript platform execution scripts (never commit/deploy)
.airo/turnscript-*

# Authoring workspace — excluded from deploy package entirely.
# The app never reads from content/ at runtime.
# Runtime seed data lives in src/server/seed/ (copied to dist/server/seed/ at build time).
# Source DOCX files and the full content/ authoring tree are stored in /private/iwillbuild-dev-assets/.
content/

# Internal platform reports — not needed at runtime
.airo/security-report.json

# Development docs / videos — not served by the app
docs/*.mp4
docs/*.mov
docs/*.avi

# HTML prototypes and archive docs — not served by the app
docs/archive/
