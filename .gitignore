*.pid.lock

# TypeScript cache
*.tsbuildinfo

# Development port configuration
.dev-ports.json

# Generated API
.api/

# SSL certificates
.ssl/*.pem

# AI Assistant Files
.claude/

# Import temporary files
.import-*

# Agent memory store
.memory/

# Turnscript platform execution scripts (never commit/deploy)
.airo/turnscript-*

# Large development-only artifacts — excluded from deploy package
# These are source/authoring files with no runtime value.
# The server reads only the compiled JSON from dist/server/seed/ at runtime.
content/starter-packs/default/source-docx/

# Internal platform reports — not needed at runtime
.airo/security-report.json

# Development docs / videos — not served by the app
docs/*.mp4
docs/*.mov
docs/*.avi
