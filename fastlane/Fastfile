require "base64"

default_platform(:ios)

platform :ios do
  desc "Archive and upload to the existing TestFlight app (no Mac required — GitHub Actions)"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    latest = 28
    begin
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "com.iwillbuild.portal"
      )
    rescue => e
      UI.important("Could not read TestFlight build number (#{e.message}); using #{latest}")
    end
    next_build = latest.to_i + 1
    increment_build_number(
      build_number: next_build,
      xcodeproj: "IWILLBUILDField.xcodeproj"
    )

    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      app_identifier: "com.iwillbuild.portal",
      team_id: "L287H9J7L3",
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "match-certs",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV["GITHUB_TOKEN"]}"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "ci"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "IWILLBUILDField.xcodeproj",
      targets: ["IWILLBUILDField"],
      team_id: "L287H9J7L3",
      bundle_identifier: "com.iwillbuild.portal",
      code_sign_identity: "iPhone Distribution",
      profile_name: ENV["sigh_com.iwillbuild.portal_appstore_profile-name"]
    )

    build_app(
      project: "IWILLBUILDField.xcodeproj",
      scheme: "IWILLBUILDField",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "IWILLBUILDField"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Native field app — camera, offline sign-on, HazChat, forms"
    )
  end
end
