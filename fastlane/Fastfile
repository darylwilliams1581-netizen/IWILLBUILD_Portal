require "base64"

default_platform(:ios)

platform :ios do
  desc "Build the completed Capacitor portal and upload it to TestFlight"
  lane :capacitor_beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    latest = 31
    begin
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "com.iwillbuild.portal",
        version: "13"
      )
    rescue => e
      UI.important("Could not read TestFlight build number (#{e.message}); using 31")
    end
    requested_build = get_build_number(
      xcodeproj: "ios/App/App.xcodeproj"
    ).to_i
    next_build = [latest.to_i + 1, requested_build, 32].max
    increment_build_number(
      build_number: next_build,
      xcodeproj: "ios/App/App.xcodeproj"
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      app_identifier: "com.iwillbuild.portal",
      team_id: "L287H9J7L3",
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "match-certs",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV['GITHUB_TOKEN']}"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "ci"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      targets: ["App"],
      team_id: "L287H9J7L3",
      bundle_identifier: "com.iwillbuild.portal",
      code_sign_identity: "iPhone Distribution",
      profile_name: ENV["sigh_com.iwillbuild.portal_appstore_profile-name"]
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "IWILLBUILD-Portal"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: "Restored completed IWIllBUIlD portal — camera and offline support"
    )
  end
end
